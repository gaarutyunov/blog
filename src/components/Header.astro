---
// Site header: the "[G icon] / Blog" trail.
//   icon  -> garutyunov.com (portfolio; the G monogram from that site)
//   Blog  -> current site (blog.garutyunov.com), shown as the current crumb.
//
// Built manually (not ga-breadcrumbs) because the breadcrumb labels are plain
// escaped text and can't hold an <img>. Styled in global.css to match the
// monospace breadcrumb look. Rendered inside ga-header (registered client-side
// in BaseLayout).
import { PORTFOLIO_URL } from "../consts";

const iconSrc = `${import.meta.env.BASE_URL}icon.png`;
---

<ga-header>
  <span class="brand-trail" slot="brand">
    <a href={PORTFOLIO_URL} class="brand-home" aria-label="garutyunov.com">
      <img src={iconSrc} alt="German Arutyunov" width="26" height="26" />
    </a>
    <span class="brand-sep" aria-hidden="true">/</span>
    <span class="brand-current" aria-current="page">Blog</span>
  </span>
</ga-header>
