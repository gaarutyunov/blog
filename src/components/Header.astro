---
// Site header: the "[G icon] / Blog" trail.
//   icon  -> garutyunov.com (portfolio; the G monogram from that site)
//   Blog  -> current site (blog.garutyunov.com), shown as the current crumb.
//
// Built manually (not ga-breadcrumbs) because the breadcrumb labels are plain
// escaped text and can't hold an <img>. Styled in global.css to match the
// monospace breadcrumb look. Rendered inside ga-header (registered client-side
// in BaseLayout).
import { PORTFOLIO_URL, GITHUB_URL } from "../consts";

const base = import.meta.env.BASE_URL;
const iconSrc = `${base}icon.png`;
const rssHref = `${base}rss.xml`;
---

<ga-header>
  <span class="brand-trail" slot="brand">
    <a href={PORTFOLIO_URL} class="brand-home" aria-label="garutyunov.com">
      <img src={iconSrc} alt="German Arutyunov" width="26" height="26" />
    </a>
    <span class="brand-sep" aria-hidden="true">/</span>
    <span class="brand-current" aria-current="page">Blog</span>
  </span>

  <!-- Right-aligned actions (ga-header default slot). -->
  <a href={rssHref} class="header-action" aria-label="RSS feed">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
      <path
        d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19.02 7.38 20 6.18 20 5 20 4 19.02 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 4.24a11.32 11.32 0 0 1 11.32 11.32H12.5A8.49 8.49 0 0 0 4 11.51V8.68Z"
      ></path>
    </svg>
  </a>
  <a
    href={GITHUB_URL}
    class="header-action"
    aria-label="GitHub repository"
    target="_blank"
    rel="noopener noreferrer"
  >
    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
      <path
        d="M12 .5C5.37.5 0 5.78 0 12.29c0 5.2 3.44 9.61 8.21 11.17.6.11.82-.25.82-.56 0-.28-.01-1.02-.02-2-3.34.71-4.04-1.58-4.04-1.58-.55-1.37-1.34-1.74-1.34-1.74-1.09-.73.08-.72.08-.72 1.21.08 1.84 1.22 1.84 1.22 1.07 1.8 2.81 1.28 3.5.98.11-.76.42-1.28.76-1.57-2.67-.3-5.47-1.31-5.47-5.82 0-1.29.47-2.34 1.24-3.17-.12-.3-.54-1.52.12-3.16 0 0 1.01-.32 3.3 1.21.96-.26 1.98-.39 3-.4 1.02.01 2.04.14 3 .4 2.29-1.53 3.3-1.21 3.3-1.21.66 1.64.24 2.86.12 3.16.77.83 1.24 1.88 1.24 3.17 0 4.52-2.81 5.52-5.49 5.81.43.36.81 1.09.81 2.2 0 1.59-.01 2.87-.01 3.26 0 .31.22.68.83.56C20.56 21.9 24 17.49 24 12.29 24 5.78 18.63.5 12 .5z"
      ></path>
    </svg>
  </a>
</ga-header>
